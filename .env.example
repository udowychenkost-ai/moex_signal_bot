TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
POSTGRES_DB=moex
POSTGRES_USER=moex
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# URL-encode special characters in the DSN password.
DATABASE_URL=postgresql+asyncpg://moex:replace-with-a-long-random-secret@postgres:5432/moex
APP_VERSION=0.6.0
GIT_COMMIT=unknown
LOG_LEVEL=INFO

# Universe and ingestion
UNIVERSE_SIZE=20
TIMEFRAMES=15m,1h,4h,1d,1w
INGESTION_INTERVAL_MINUTES=15
SCANNING_INTERVAL_MINUTES=15
LIFECYCLE_INTERVAL_MINUTES=5
REPORTING_INTERVAL_MINUTES=1
DAILY_SUMMARY_HOUR=19
DAILY_SUMMARY_MINUTE=15
SCHEDULER_TIMEZONE=Europe/Moscow
DATA_FRESHNESS_LIMITS_MINUTES=5m:30,15m:60,1h:240,4h:1440,1d:5760,1w:14400
SMALL_SAMPLE_THRESHOLD=30

# Isolated v2.4 intraday mode. Enabling it does not change historical INTRADAY_1D.
# Immediate actions still fail closed until Data SLA, risk and audit gates pass.
INTRADAY_V24_ENABLED=false
INTRADAY_V24_STRATEGY_VERSION=intraday_v2_4
INTRADAY_V24_EXECUTION_1M_ENABLED=false
INTRADAY_V24_MAX_HOLDING_TRADING_DAYS=2
INTRADAY_V24_LEVERAGE_ENABLED=false
INTRADAY_V24_STRUCTURAL_ATR_BUFFER_MULTIPLIER=
INTRADAY_V24_MARKET_SUMMARY_HOUR=11

MOEX_REQUEST_CONCURRENCY=5
MOEX_REQUEST_TIMEOUT_SECONDS=20
MOEX_MAX_RETRIES=3
ENABLE_ORDERBOOK=false
# V2.1.5.1: public ISS supplies delayed level-1 BID/OFFER; paid ISS may supply depth.
# Missing public BIDDEPTH/OFFERDEPTH is stored as NULL and is never simulated.
ORDERBOOK_INTERVAL_MINUTES=2
ORDERBOOK_REQUEST_CONCURRENCY=5

# V2.4 Data SLA: intentionally NOT_CONFIGURED until every value below is set
# by the operator. Units for latency/age are seconds. Allowed source classes:
# OFFICIAL_REALTIME, OFFICIAL_PUBLIC, BROKER_REALTIME, LICENSED_REALTIME,
# AGGREGATED, MANUAL_CONFIRMED. Do not copy illustrative limits blindly.
DATA_SLA_VERSION=v2_4_unconfigured
# MAX_LATENCY_ENTER_NOW=
# MAX_LATENCY_POSITION_MANAGEMENT=
# MAX_LATENCY_INTRADAY_ANALYSIS=
# REQUIRED_QUOTE_SOURCE_CLASS=
# REQUIRED_VOLUME_SOURCE_CLASS=
# REQUIRED_ORDERBOOK_SOURCE_CLASS=
# MICROSTRUCTURE_MAX_SPREAD_PCT=
# MICROSTRUCTURE_ORDERBOOK_MAX_AGE_SECONDS=
# V2.4 production liquidity model also remains NOT_RELIABLY_CALCULABLE until
# every policy value is explicitly approved. Public level-1 quantity=NULL is
# not depth and cannot satisfy the order-book cap.
# LIQUIDITY_V2_ADV_PARTICIPATION_RATE=
# LIQUIDITY_V2_SESSION_PARTICIPATION_RATE=
# LIQUIDITY_V2_ORDERBOOK_PARTICIPATION_RATE=
# LIQUIDITY_V2_NORMAL_EXIT_PARTICIPATION_RATE=
# LIQUIDITY_V2_FAST_EXIT_PARTICIPATION_RATE=
# LIQUIDITY_V2_STRESS_EXIT_PARTICIPATION_RATE=
# LIQUIDITY_V2_MAX_EXPECTED_SLIPPAGE_BPS=
# LIQUIDITY_V2_MAX_MARKET_IMPACT_BPS=

LIQUIDITY_ADV_DAYS=20
LIQUIDITY_TURNOVER_PARTICIPATION=0.0025
LIQUIDITY_BOOK_PARTICIPATION=0.10
LIQUIDITY_BOOK_BAND_NARROW=0.0025
LIQUIDITY_BOOK_BAND_PRIMARY=0.005
LIQUIDITY_BOOK_BAND_WIDE=0.01
LIQUIDITY_ORDERBOOK_FRESHNESS_SECONDS=300
LIQUIDITY_TURNOVER_FRESHNESS_SECONDS=1800
LIQUIDITY_SPREAD_TIGHT_THRESHOLD=0.001
LIQUIDITY_SPREAD_NORMAL_THRESHOLD=0.0025
LIQUIDITY_SPREAD_WIDE_THRESHOLD=0.005
LIQUIDITY_SPREAD_TIGHT_MODIFIER=1.00
LIQUIDITY_SPREAD_NORMAL_MODIFIER=0.85
LIQUIDITY_SPREAD_WIDE_MODIFIER=0.60
LIQUIDITY_SPREAD_VERY_WIDE_MODIFIER=0.35
LIQUIDITY_UNKNOWN_SPREAD_MODIFIER=0.85
LIQUIDITY_LOW_VOLATILITY_MODIFIER=1.00
LIQUIDITY_NORMAL_VOLATILITY_MODIFIER=0.90
LIQUIDITY_HIGH_VOLATILITY_MODIFIER=0.70
LIQUIDITY_EXTREME_VOLATILITY_MODIFIER=0.45
LIQUIDITY_UNKNOWN_VOLATILITY_MODIFIER=0.75
LIQUIDITY_HIGH_ADV_THRESHOLD=1000000000
LIQUIDITY_MEDIUM_ADV_THRESHOLD=100000000
LIQUIDITY_HIGH_RELATIVE_TURNOVER=0.75
LIQUIDITY_MEDIUM_RELATIVE_TURNOVER=0.35
LIQUIDITY_HIGH_DEPTH_THRESHOLD=10000000
LIQUIDITY_MEDIUM_DEPTH_THRESHOLD=2000000
LIQUIDITY_RATING_ADV_WEIGHT=0.30
LIQUIDITY_RATING_RELATIVE_TURNOVER_WEIGHT=0.15
LIQUIDITY_RATING_SPREAD_WEIGHT=0.20
LIQUIDITY_RATING_DEPTH_WEIGHT=0.25
LIQUIDITY_RATING_FRESHNESS_WEIGHT=0.10
LIQUIDITY_MIN_KNOWN_RATING_WEIGHT=0.50
LIQUIDITY_HIGH_RATING_SCORE=0.75
LIQUIDITY_MEDIUM_RATING_SCORE=0.45
MARKET_CONTEXT_ENABLED=true
MARKET_BENCHMARK=IMOEX
# IMOEX is mandatory for scoring; RTSI/RGBITR/RVI are stored as secondary daily diagnostics.
MARKET_CONTEXT_SYMBOLS=IMOEX,RTSI,RGBITR,RVI

# Public iss.moex.com returns candles without a key, but L2 can require ISS+ access.
# For ISS+ set MOEX_BASE_URL=https://apim.moex.com/iss and provide its bearer token.
MOEX_BASE_URL=https://iss.moex.com/iss
MOEX_API_TOKEN=

# Echelon thresholds. The allow-list remains echelon 1 even when a live metric is absent.
ECHELON1_MIN_MARKET_CAP=500000000000
ECHELON1_MIN_DAILY_TURNOVER=500000000
ECHELON1_MIN_FREE_FLOAT=10
ECHELON2_MIN_DAILY_TURNOVER=25000000
BLUE_CHIP_TICKERS=SBER,GAZP,LKOH,YDEX,NVTK,GMKN,TATN,ROSN,PLZL,MOEX,MTSS,MGNT,CHMF,NLMK,ALRS,VTBR,SIBN,PHOR,IRAO,SNGS

# Signal and risk model
DEFAULT_TIMEFRAME=15m
SIGNAL_THRESHOLD=25
TECHNICAL_SCORING_MODEL=legacy
# Horizon-specific TradingIdea selectors. Keep the declared OOS-safe policy.
INTRADAY_TECHNICAL_SCORING_MODEL=legacy
SWING_TECHNICAL_SCORING_MODEL=legacy
POSITION_TECHNICAL_SCORING_MODEL=legacy
SCORE_WEIGHT_TREND=25
SCORE_WEIGHT_MOMENTUM=25
SCORE_WEIGHT_MACD=20
SCORE_WEIGHT_BOLLINGER=15
SCORE_WEIGHT_VOLUME=15
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_MULTIPLIER=3.0
RISK_METHOD=atr
LEVEL_BUFFER_PCT=0.3
MINIMUM_REWARD_RISK_RATIO=2.0
DEFAULT_RISK_PER_TRADE_PCT=1.0

# Reviewed normalized facts from official disclosures only. Missing data is safe:
# the fundamental factor is omitted and available factor weights are renormalized.
FUNDAMENTAL_ENABLED=true
FUNDAMENTAL_JSON_PATH=/app/fundamentals/official.json

# V2 deterministic QualityGate. Defaults are conservative starting policy,
# not claimed as statistically optimal until sufficient V2 forward observations exist.
STRATEGY_VERSION=v2_ai_quality_filter
QUALITY_GATE_ENABLED=true
QUALITY_MIN_TECHNICAL_SCORE=35
QUALITY_MIN_TOTAL_SCORE=35
INTRADAY_QUALITY_MIN_CONFIRMATIONS=4
SWING_QUALITY_MIN_CONFIRMATIONS=5
POSITION_QUALITY_MIN_CONFIRMATIONS=5
QUALITY_MIN_TIMEFRAME_CONFIRMATIONS=2
QUALITY_CONFIRMATION_SCORE=10
QUALITY_CONFLICT_SCORE=15
QUALITY_MAX_CONFLICTS=2
QUALITY_MIN_VOLUME_RATIO=1.0
QUALITY_MIN_DAILY_TURNOVER=25000000
QUALITY_STRONG_REGIME_SCORE=50
QUALITY_REGIME_OVERRIDE_SCORE=40
QUALITY_AI_CANDIDATES_PER_HORIZON=5

# Batch ranking, daily caps and same ticker/horizon/direction cooldown.
INTRADAY_MAX_NEW_IDEAS_PER_SCAN=0
SWING_MAX_NEW_IDEAS_PER_SCAN=3
POSITION_MAX_NEW_IDEAS_PER_SCAN=3
INTRADAY_MAX_NEW_IDEAS_PER_DAY=0
SWING_MAX_NEW_IDEAS_PER_DAY=5
POSITION_MAX_NEW_IDEAS_PER_DAY=5
INTRADAY_COOLDOWN_HOURS=24
SWING_COOLDOWN_HOURS=72
POSITION_COOLDOWN_HOURS=168

# AI second opinion (fail closed). Without a valid key, PASS candidates are stored
# as WAIT research observations and are not published.
AI_FILTER_ENABLED=true
AI_ALLOW_UNREVIEWED_FALLBACK=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.6-flash
AI_FALLBACK_MODEL=gemini-flash-lite-latest
# OpenAI remains an optional provider. Set AI_PROVIDER=openai, AI_MODEL to an
# OpenAI model, and configure this key to use it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=4096
# Used only for telemetry estimates; update when provider pricing changes.
AI_INPUT_COST_PER_MILLION=0.30
AI_OUTPUT_COST_PER_MILLION=2.50
AI_FALLBACK_INPUT_COST_PER_MILLION=0.18
AI_FALLBACK_OUTPUT_COST_PER_MILLION=0.72

# Trading ideas and user-facing reports
IDEA_MINIMUM_CONFIDENCE=60
IDEA_MATERIAL_CONFIDENCE_DELTA=7.5
DEFAULT_REPORT_FREQUENCY=strong
DEFAULT_IDEA_HORIZON=all
DEFAULT_MINIMUM_CONFIDENCE=70
PAPER_ACCOUNT_SIZE=1000000
PAPER_COMMISSION_PCT=0.05
PAPER_BUY_SLIPPAGE_BPS=5
PAPER_SELL_SLIPPAGE_BPS=5

# Live observation policy. No broker integration or order execution exists.
INTRADAY_OBSERVATION_MODE=RESEARCH
SWING_OBSERVATION_MODE=RESEARCH
POSITION_OBSERVATION_MODE=PAPER
BACKTEST_COMMISSION_PCT=0.05
BACKTEST_BUY_SLIPPAGE_BPS=5
BACKTEST_SELL_SLIPPAGE_BPS=5

# Validation/calibration dataset and report output (historical DB is gitignored)
RESEARCH_DATABASE_URL=sqlite+aiosqlite:///./data/research.db
RESEARCH_CONFIG_PATH=research.toml
RESEARCH_OUTPUT_DIR=reports/backtests
RESEARCH_WORKERS=4
