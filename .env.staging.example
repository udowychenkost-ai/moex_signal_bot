# Copy to .env.staging. Never commit real secrets.
TELEGRAM_BOT_TOKEN=
POSTGRES_DB=moex
POSTGRES_USER=moex
POSTGRES_PASSWORD=replace-with-a-long-random-secret

LOG_LEVEL=INFO
MOEX_BASE_URL=https://iss.moex.com/iss
MOEX_API_TOKEN=
MOEX_REQUEST_CONCURRENCY=5
MOEX_REQUEST_TIMEOUT_SECONDS=20
MOEX_MAX_RETRIES=3
ENABLE_ORDERBOOK=false

UNIVERSE_SIZE=20
TIMEFRAMES=5m,15m,1h,4h,1d,1w
INGESTION_INTERVAL_MINUTES=15
SCHEDULER_TIMEZONE=Europe/Moscow

# Keep production defaults until the completed OOS report justifies a change.
TECHNICAL_SCORING_MODEL=legacy
SIGNAL_THRESHOLD=25
IDEA_MINIMUM_CONFIDENCE=60
MINIMUM_REWARD_RISK_RATIO=2.0
DEFAULT_RISK_PER_TRADE_PCT=1.0

# Forward simulation only. The application contains no broker execution adapter.
PAPER_ACCOUNT_SIZE=1000000
PAPER_COMMISSION_PCT=0.05
PAPER_BUY_SLIPPAGE_BPS=5
PAPER_SELL_SLIPPAGE_BPS=5
